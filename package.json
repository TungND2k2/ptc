{
    "name": "lsm-service",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "prebuild": "rimraf dist",
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start-wk:dev": "cross-env APP_TYPE=worker nest start --watch",
        "start-api:dev": "cross-env APP_TYPE=api nest start --watch",
        "start-mic:dev": "cross-env APP_TYPE=microservice nest start --watch",
        "start-mic-redis:dev": "cross-env APP_TYPE=microservice-redis nest start --watch",
        "start-mic-log:dev": "cross-env APP_TYPE=microservice-log nest start --watch",
        "start-cron:dev": "cross-env APP_TYPE=cron nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "setup-cors": "ts-node scripts/setup-s3-cors.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.971.0",
        "@aws-sdk/s3-request-presigner": "^3.971.0",
        "@nestjs/cache-manager": "^3.1.0",
        "@nestjs/common": "^10.4.15",
        "@nestjs/config": "^3.3.0",
        "@nestjs/core": "^10.4.15",
        "@nestjs/jwt": "^10.2.0",
        "@nestjs/mapped-types": "^2.0.5",
        "@nestjs/microservices": "^10.4.15",
        "@nestjs/mongoose": "^10.1.0",
        "@nestjs/passport": "^10.0.3",
        "@nestjs/platform-express": "^10.4.15",
        "@nestjs/platform-socket.io": "^10.4.15",
        "@nestjs/schedule": "^6.1.0",
        "@nestjs/swagger": "^8.0.7",
        "@nestjs/typeorm": "^10.0.2",
        "@nestjs/websockets": "^10.4.15",
        "@types/passport-google-oauth20": "^2.0.17",
        "amqp-connection-manager": "^4.1.14",
        "amqplib": "^0.10.5",
        "axios": "^1.13.2",
        "bcryptjs": "^3.0.3",
        "cache-manager": "^7.2.8",
        "cache-manager-ioredis": "^2.1.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "cross-env": "^7.0.3",
        "generate-password": "^1.7.1",
        "geoip-lite": "^1.4.10",
        "ioredis": "^5.9.2",
        "mongodb": "6.11.0",
        "mongoose": "^8.9.2",
        "passport": "^0.7.0",
        "passport-google-oauth20": "^2.0.0",
        "passport-http": "^0.3.0",
        "passport-jwt": "^4.0.1",
        "pokemon": "^2.3.4",
        "reflect-metadata": "^0.2.2",
        "rimraf": "^6.0.1",
        "rxjs": "^7.8.1",
        "socket.io": "^4.8.1",
        "socket.io-client": "^4.8.1",
        "swagger-ui-express": "^5.0.1",
        "ts-md5": "^1.3.1",
        "typeorm": "^0.3.20",
        "webpack": "^5.97.1"
    },
    "devDependencies": {
        "@nestjs/cli": "^10.4.9",
        "@nestjs/schematics": "^10.2.3",
        "@nestjs/testing": "^10.4.15",
        "@types/bcryptjs": "^2.4.6",
        "@types/express": "^5.0.0",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.10.5",
        "@types/passport-jwt": "^4.0.1",
        "@types/supertest": "^6.0.2",
        "@typescript-eslint/eslint-plugin": "^8.19.1",
        "@typescript-eslint/parser": "^8.19.1",
        "eslint": "^9.18.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.2.1",
        "jest": "^29.7.0",
        "prettier": "^3.4.2",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.5",
        "ts-loader": "^9.5.1",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.7.2"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}
